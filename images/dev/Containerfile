FROM fedora:latest

ARG GIT_SHA=unknown
ARG IMAGE_VERSION=local
ARG SOURCE_DATE_EPOCH

LABEL org.opencontainers.image.title="ahi-dev" \
      org.opencontainers.image.description="Opinionated dev shell image consumed by ahi dev" \
      org.opencontainers.image.source="https://github.com/iancleary/ahi-images" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="1970-01-01T00:00:00Z"

# Common CLI tools; keep the list opinionated but small. Node is deliberately
# absent. shadow-utils (usermod, groupmod) and util-linux (setpriv) are
# what the entrypoint uses to remap the dev user to the host uid and gid.
RUN dnf install -y --setopt=install_weak_deps=False \
        bash \
        bash-completion \
        ca-certificates \
        bat \
        curl \
        fd-find \
        git \
        gnupg2 \
        jq \
        just \
        less \
        openssh-clients \
        procps-ng \
        ripgrep \
        shadow-utils \
        sudo \
        tmux \
        unzip \
        util-linux \
        vim \
        wget \
        zsh \
    && dnf clean all

# Non-root user with passwordless sudo. /work is where ahi dev mounts the
# working directory; it exists and is writable even without a mount.
RUN useradd --create-home --shell /bin/bash --user-group dev \
    && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev \
    && mkdir /work \
    && chown dev:dev /work

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

# powerlevel10k for zsh, pinned by commit, with gitstatusd prefetched and
# the lean preset as ~/.p10k.zsh. Lives under /home/dev so the uid remap
# follows it. bash stays the login shell; ahi dev --shell zsh opens it.
COPY --chown=dev:dev powerlevel10k.env install_powerlevel10k.sh zshrc /tmp/p10k/

USER dev
WORKDIR /home/dev
RUN bash /tmp/p10k/install_powerlevel10k.sh && rm -rf /tmp/p10k

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
