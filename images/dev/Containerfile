FROM fedora:latest

ARG GIT_SHA=unknown
ARG IMAGE_VERSION=local
ARG SOURCE_DATE_EPOCH

LABEL org.opencontainers.image.title="ahi-dev" \
      org.opencontainers.image.description="Opinionated dev shell image consumed by ahi dev" \
      org.opencontainers.image.source="https://github.com/iancleary/ahi-images" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="1970-01-01T00:00:00Z"

# Common CLI tools; keep the list opinionated but small
RUN dnf install -y --setopt=install_weak_deps=False \
        bash \
        bash-completion \
        ca-certificates \
        bat \
        curl \
        fd-find \
        git \
        gnupg2 \
        jq \
        just \
        less \
        openssh-clients \
        procps-ng \
        ripgrep \
        sudo \
        tmux \
        unzip \
        vim \
        wget \
        zsh \
    && dnf clean all

# Non-root user with passwordless sudo
RUN useradd --create-home --shell /bin/bash --user-group dev \
    && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev

USER dev
WORKDIR /home/dev

COPY --chown=dev:dev entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
