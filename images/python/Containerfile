# ahi-dev-python: ahi-dev plus a pinned uv and one pinned CPython 3.14
# installed by uv into /opt/python. /opt/python is owned by dev and listed in
# AHI_DEV_REMAP_PATHS so the entrypoint's uid remap follows it.
ARG BASE_IMAGE=ghcr.io/iancleary/ahi-dev:latest
FROM ${BASE_IMAGE}

ARG GIT_SHA=unknown
ARG IMAGE_VERSION=local
ARG BASE_DIGEST=unknown
ARG SOURCE_DATE_EPOCH

USER root
COPY uv.env python.env install_python.sh /tmp/python/
RUN bash /tmp/python/install_python.sh && rm -rf /tmp/python

ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_BIN_DIR=/opt/python/bin \
    PATH=/opt/python/bin:/home/dev/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    AHI_DEV_REMAP_PATHS=/opt/python

USER dev
WORKDIR /home/dev

LABEL org.opencontainers.image.title="ahi-dev-python" \
      org.opencontainers.image.description="ahi-dev plus pinned uv and CPython 3.14 for ahi dev" \
      org.opencontainers.image.source="https://github.com/iancleary/ahi-images" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.base.name="ghcr.io/iancleary/ahi-dev" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      org.opencontainers.image.created="1970-01-01T00:00:00Z"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
