# CPython installed by `uv python install` from one python-build-standalone
# archive. The build writes a uv downloads JSON holding only this build, and
# uv checks the sha256 before unpacking. The sha256 is the SHA256SUMS entry
# for install_only_stripped.
PYTHON_VERSION=3.14.10
PYTHON_STANDALONE_TAG=20261026
PYTHON_ARCHIVE_URL_AMD64=https://github.com/astral-sh/python-build-standalone/releases/download/20261026/cpython-3.14.10+20261026-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
PYTHON_ARCHIVE_URL_ARM64=https://github.com/astral-sh/python-build-standalone/releases/download/20261026/cpython-3.14.10+20261026-aarch64-unknown-linux-gnu-install_only_stripped.tar.gz
PYTHON_SHA256_AMD64=4d3c16c59ed0802a3d1d34d8bce504b15ceeaff39d62dadecc6a9fa803412aed
PYTHON_SHA256_ARM64=90f48337bc3dd4ae6eda81e001e4c981236d403b6b5a07778bbdf94ee423dc00
PYTHON_CHECKSUM_SOURCE=upstream_shared_file:SHA256SUMS
