# ahi-dev-rust: ahi-dev plus rustup with a pinned stable toolchain, clippy,
# and rustfmt. gcc is the linker cargo uses. The toolchain lives under
# /home/dev so the uid remap in the entrypoint follows it.
ARG BASE_IMAGE=ghcr.io/iancleary/ahi-dev:latest
FROM ${BASE_IMAGE}

ARG GIT_SHA=unknown
ARG IMAGE_VERSION=local
ARG BASE_DIGEST=unknown
ARG SOURCE_DATE_EPOCH

USER root
RUN dnf install -y --setopt=install_weak_deps=False gcc \
    && dnf clean all

COPY --chown=dev:dev rust.env install_rust.sh /tmp/rust/

USER dev
ENV RUSTUP_HOME=/home/dev/.rustup \
    CARGO_HOME=/home/dev/.cargo \
    PATH=/home/dev/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CARGO_TARGET_DIR=/work/target/dev

RUN bash /tmp/rust/install_rust.sh && rm -rf /tmp/rust

WORKDIR /home/dev

LABEL org.opencontainers.image.title="ahi-dev-rust" \
      org.opencontainers.image.description="ahi-dev plus a pinned stable Rust toolchain for ahi dev" \
      org.opencontainers.image.source="https://github.com/iancleary/ahi-images" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.base.name="ghcr.io/iancleary/ahi-dev" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      org.opencontainers.image.created="1970-01-01T00:00:00Z"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
