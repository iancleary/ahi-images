# Rust toolchain installed through rustup. rustup-init is downloaded from the
# versioned archive and checked against the sha256 published beside it.
# rustup then verifies every component against the signed channel manifest.
RUST_VERSION=1.99.1
RUSTUP_VERSION=1.29.3
RUSTUP_INIT_URL_AMD64=https://static.rust-lang.org/rustup/archive/1.29.3/x86_64-unknown-linux-gnu/rustup-init
RUSTUP_INIT_URL_ARM64=https://static.rust-lang.org/rustup/archive/1.29.3/aarch64-unknown-linux-gnu/rustup-init
RUSTUP_INIT_SHA256_AMD64=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
RUSTUP_INIT_SHA256_ARM64=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282
RUSTUP_INIT_CHECKSUM_SOURCE=upstream_shared_file:rustup-init.sha256
